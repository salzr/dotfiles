function parse_git_branch {
  ref=$(git symbolic-ref HEAD 2> /dev/null) || return
  echo "("${ref#refs/heads/}")"
}

function _dir_chomp() {
  local p=${PWD/#$HOME/\~} parr
  local m=$(($1 +1)) c
  local o=$IFS
  local v

  declare -a pp

  IFS=/
  read -a parr <<< "$p"
  IFS="$o"

  c="${#parr[*]}"
  v=$(($c-$m))
  for i in "${!parr[@]}"; do
    if [ $i -lt $v ]; then
      pp+=("${parr[$i]:0:1}")
    else
      pp+=("${parr[$i]}")
    fi
  done
  IFS=/; echo "${pp[*]}"
}

function proml {
  local BLUE="\[\033[0;34m\]"
  local RED="\[\033[0;31m\]"
  local LIGHT_RED="\[\033[1;31m\]"
  local GREEN="\[\033[0;32m\]"
  local LIGHT_GREEN="\[\033[1;32m\]"
  local WHITE="\[\033[1;37m\]"
  local LIGHT_GRAY="\[\033[0;37m\]"
  local YELLOW="\[\033[0;33m\]"
  local NONE="\[\033[0m\]"
  case $TERM in
    xterm*)
      TITLEBAR='\[\033]0;\u@\h:\w\007\]'
    ;;
    *)
      TITLEBAR=""
    ;;
  esac

  # PS1="\u\$(kube_ps1): $RED\w$NONE$YELLOW\$(parse_git_branch)$NONE\$ "
  PS1="\u: $RED\$(_dir_chomp 1)$NONE$LIGHT_GREEN\$(parse_git_branch)$NONE\$ "
  PS2='> '
  PS4='+ '
}
proml

WORKSPACE_DIR="${WORKSPACE_DIR:-${HOME}/workspace}"

function cdworkspace {
  cd "${WORKSPACE_DIR}/$1"
}

function _cdworkspace {
  local cur
  cur="${COMP_WORDS[COMP_CWORD]}"

  COMPREPLY=( $(cd "${WORKSPACE_DIR}" 2>/dev/null && compgen -d -S/ -- "$cur") )
}

complete -o filenames -o nospace -F _cdworkspace cdworkspace